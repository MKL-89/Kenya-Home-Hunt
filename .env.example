# Settings HomeHunt needs to run. Copy to .env and fill in real values.
# Never commit the real .env.

# PostgreSQL connection string. A Supabase project works: use its
# "Connection string" (Session pooler) from Project Settings → Database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/homehunt

# Clerk (https://dashboard.clerk.com → API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Ports: API server and website (Vite)
PORT=8080
BASE_PATH=/

# Image storage (Replit object storage only, for now)
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
